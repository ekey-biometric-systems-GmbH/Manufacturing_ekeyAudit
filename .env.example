# ------------------------------------------------------------------
# ekeyAudit - Beispielkonfiguration
# Fuer Docker nach `.env.docker` kopieren und Werte eintragen.
# Diese Vorlage wird committet, .env / .env.docker NIE.
# ------------------------------------------------------------------

# --- Webserver (im Container per Dockerfile bereits gesetzt) ---
#EKEY_HOST=0.0.0.0
#EKEY_PORT=8080
#EKEY_DEBUG=false

# Pflicht im Produktivbetrieb: langer, zufaelliger Wert
EKEY_AUDIT_SECRET_KEY=bitte-aendern

# --- Datenbank ---
EKEY_DB_BACKEND=mssql
EKEY_MSSQL_SERVER=SATURN
EKEY_MSSQL_DATABASE=ekeyAuditGovernance
EKEY_MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Im Container keine Windows-Authentifizierung moeglich -> SQL-Login
EKEY_MSSQL_TRUSTED_CONNECTION=no
EKEY_MSSQL_USER=
EKEY_MSSQL_PASSWORD=
#EKEY_MSSQL_TIMEOUT=5

# --- Active Directory / LDAP (optional, leer = manuelle Mitarbeiterliste) ---
#EKEY_AD_SERVER=ldap://dc01.ekey.local
#EKEY_AD_USE_SSL=true
#EKEY_AD_BASE_DN=OU=Mitarbeiter,DC=ekey,DC=local
#EKEY_AD_BIND_USER=ekey\svc_audit
#EKEY_AD_BIND_PASSWORD=
